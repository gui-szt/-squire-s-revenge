			##timer_rock.wait_time =time
			timer.start()
			return instance8




func _process(delta):
	if moment>0:
		instance1.position.x += delta* -200
	if moment >1:
		instance2.position.x += delta* -200
	if moment>2:
		instance3.position.x += delta* -200
	if moment >3:
		instance4.position.x += delta* -200
	if moment >4:
		instance5.position.x += delta* -200
	if moment >5:
		instance6.position.x += delta* -200
	if moment >6:
		instance7.position.x += delta* -200
	if moment >7:
		instance8.position.x += delta* -200
	
	if moment >= 8:
		moment = 0
"

