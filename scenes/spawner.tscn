			timer.start()
			return instance3
		4:
			instance4 = scene.instantiate()
			parent.add_child(instance4)
			instance = instance4
			obst()
			instance4.global_position.y = posit
			instance4.global_position.x = 150
			var spawn_rate = time_offset / (0.5 + (GlobalVars.level * 0.1))
			tim = 0.5
			timer.wait_time = spawn_rate
			##timer_rock.wait_time =time
			timer.start()
			return instance4
		5:
			instance5 = scene.instantiate()
			parent.add_child(instance5)
			instance = instance5
			obst()
			instance5.global_position.y = posit
			instance5.global_position.x = 150
			var spawn_rate = time_offset / (0.5 + (GlobalVars.level * 0.1))
			tim = 0.5
			timer.wait_time = spawn_rate
			##timer_rock.wait_time =time
			timer.start()
			return instance5
		6:
			instance6 = scene.instantiate()
