			instance6.global_position.y = posit
			instance6.global_position.x = 150
			var spawn_rate = time_offset / (0.5 + (GlobalVars.level * 0.1))
			tim = 0.5
			timer.wait_time = spawn_rate
			##timer_rock.wait_time =time
			timer.start()
			return instance6
		7:
			instance7 = scene.instantiate()
			parent.add_child(instance7)
			instance = instance7
			obst()
			instance7.global_position.y = posit
			instance7.global_position.x = 150
			var spawn_rate = time_offset / (0.5 + (GlobalVars.level * 0.1))
			tim = 0.5
			timer.wait_time = spawn_rate
			##timer_rock.wait_time =time
			timer.start()
			return instance7
		8:
			instance8= scene.instantiate()
			parent.add_child(instance8)
			instance = instance8
			obst()
			instance8.global_position.y = posit
			instance8.global_position.x = 150
			var spawn_rate = time_offset / (0.5 + (GlobalVars.level * 0.1))
			tim = 0.5
